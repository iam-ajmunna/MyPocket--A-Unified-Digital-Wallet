datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  phone        String        @unique
  passwordHash String        @map("password_hash")
  fullName     String        @map("full_name")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  userKey       UserKey?
  cards         BankCard[]
  mfsAccounts   MfsAccount[]
  documents     Document[]
  certificates  Certificate[]
  transitPasses TransitPass[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserKey {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  wrappedDek String   @map("wrapped_dek")
  iv         String
  authTag    String   @map("auth_tag")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_keys")
}

model BankCard {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  bankName          String    @map("bank_name")
  lastFourDigits    String    @map("last_four_digits")
  encryptedCardData String    @map("encrypted_card_data")
  iv                String
  authTag           String    @map("auth_tag")
  confirmedAt       DateTime? @map("confirmed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bank_cards")
}

model MfsAccount {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  provider      String    // bKash, Nagad, Upay
  accountNumber String    @map("account_number")
  accountName   String    @map("account_name")
  qrCodeToken   String?   @map("qr_code_token") // Revocable reference token for payment QR
  smartSync     Boolean   @default(false) @map("smart_sync") // Android Notification listener opt-in
  confirmedAt   DateTime? @map("confirmed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfs_accounts")
}

model Document {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  docType            String    @map("doc_type")
  docNumberMasked    String    @map("doc_number_masked")
  encryptedFields    String    @map("encrypted_fields")
  encryptedRawScan   String?   @map("encrypted_raw_scan")
  iv                 String
  authTag            String    @map("auth_tag")
  confirmedAt        DateTime? @map("confirmed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Certificate {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String
  issuer        String
  issueDate     String   @map("issue_date")
  category      String
  subCategory   String?  @map("sub_category")
  encryptedData String   @map("encrypted_data")
  iv            String
  authTag       String   @map("auth_tag")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certificates")
}

model TransitPass {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  name           String
  lastFourDigits String    @map("last_four_digits")
  transitType    String    @map("transit_type")
  expiryDate     String    @map("expiry_date")
  balance        Float     @default(0)
  qrToken        String?   @map("qr_token")
  encryptedData  String    @map("encrypted_data")
  iv             String
  authTag        String    @map("auth_tag")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transit_passes")
}
