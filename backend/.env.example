# Application Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://mypocket_user:mypocket_secure_pass@localhost:5432/mypocket_db?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="dev_super_secret_access_key_change_in_production_32bytes"
JWT_REFRESH_SECRET="dev_super_secret_refresh_key_change_in_production_32bytes"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Master Encryption Key (KEK - Key Encryption Key for Envelope Encryption)
# Must be a 32-byte hex string (64 characters)
MASTER_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
